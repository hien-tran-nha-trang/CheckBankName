# Nguồn tra cứu: tracuubank (mặc định) hoặc vietqr
LOOKUP_PROVIDER=tracuubank

# https://tracuubank.com/register -> Thông tin cá nhân -> tạo API key (100đ / lượt tra thành công)
TRACUUBANK_API_KEY=

# VietQR (https://my.vietqr.io) – API lookup đã ngừng cho gói Free từ 20/08/2024
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
